---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  coverStyle?: 'petrol' | 'dark' | 'pale';
  cover?: string;
  pubDate: Date;
}

const { slug, title, excerpt, category, coverStyle = 'petrol', cover, pubDate } = Astro.props;

const coverClass = cover ? 'has-image' : coverStyle === 'petrol' ? '' : coverStyle;
const coverInline = cover
  ? `background-image:url(${cover});background-size:cover;background-position:center;aspect-ratio:1600/840;height:auto;`
  : undefined;

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(pubDate);
---

<article class="card">
  <a href={`/blog/${slug}/`}>
    <div class={`cover ${coverClass}`} style={coverInline}>
      <span class="tag">{category}</span>
    </div>
    <div class="body">
      <h3>{title}</h3>
      <p class="excerpt">{excerpt}</p>
      <div class="meta">Fora da Ata · {formattedDate}</div>
    </div>
  </a>
</article>

<style>
  /* sobre foto/arte, a etiqueta da editoria precisa de fundo mais forte para ler bem */
  .cover.has-image .tag {
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
  }
</style>
