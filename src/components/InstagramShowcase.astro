---
import ig from '../data/instagram.json';

const handle = ig.handle.replace('@', '');
const profileUrl = `https://www.instagram.com/${handle}/`;
// mostra os 5 mais recentes (o primeiro da lista é o mais novo)
const posts = (ig.posts as { image: string; url: string; alt?: string }[]).slice(0, 5);
---

<div class="ig-band">
  <section>
    <div class="wrap">
      <div class="sec-head">
        <div>
          <div class="eyebrow">@{handle}</div>
          <h2>No Instagram</h2>
        </div>
        <p>Os posts mais recentes do perfil. Clique para ver no Instagram.</p>
      </div>

      {posts.length > 0 && (
        <div class="ig-grid">
          {posts.map((p) => (
            <a class="ig-card ig-photo" href={p.url} target="_blank" rel="noopener noreferrer">
              <img src={p.image} alt={p.alt ?? 'Post do Instagram do Fora da Ata'} loading="lazy" />
            </a>
          ))}
        </div>
      )}

      <p style="margin-top:24px;">
        <a class="btn" href={profileUrl} target="_blank" rel="noopener noreferrer">Seguir @{handle}</a>
      </p>
    </div>
  </section>
</div>

<style>
  .ig-photo { padding: 0; overflow: hidden; display: block; }
  .ig-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s ease; }
  .ig-photo:hover img { transform: scale(1.03); }
</style>
