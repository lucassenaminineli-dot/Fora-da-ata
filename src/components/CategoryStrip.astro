---
import { CATEGORIES } from '../utils/categories';

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
---

<div class="cat-strip">
  <div class="wrap">
    <a href="/" class={!activeSlug ? 'active' : ''}>Todos</a>
    {CATEGORIES.map((c) => (
      <a href={`/tag/${c.slug}/`} class={activeSlug === c.slug ? 'active' : ''}>
        {c.name}
      </a>
    ))}
  </div>
</div>
